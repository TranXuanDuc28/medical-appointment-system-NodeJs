# =====================================================================
#  BACKEND – MẪU BIẾN MÔI TRƯỜNG.  Sao chép thành `.env` rồi điền giá trị.
#  KHÔNG commit file `.env` và KHÔNG ghi giá trị thật vào file mẫu này.
#  [BẮT BUỘC] = server từ chối khởi động nếu thiếu (xem src/config/env.js).
# =====================================================================

# ---------------------------------------------------------------------
# 1. SERVER
# ---------------------------------------------------------------------
# Cổng chạy backend (mặc định 6969). Frontend trỏ tới đây qua REACT_APP_BACKEND_URL.
PORT=6969
# development | production
#  - development: bật các route demo /crud, cho phép CORS từ localhost và mạng LAN (192.168.x.x)
#  - production : tắt route demo, cookie bật `secure`, JWT secret phải >= 32 ký tự,
#                 CORS chỉ nhận origin khai báo ở URL_REACT / CORS_ORIGINS
NODE_ENV=development
# URL frontend (dùng cho link xác nhận email, link thanh toán PayOS và CORS). Không có dấu "/" cuối.
URL_REACT=http://localhost:3000
# Các origin được phép gọi API, ngăn cách bằng dấu phẩy (thêm ngoài URL_REACT). Vd: https://app.example.com,https://admin.example.com
CORS_ORIGINS=
# Đứng sau reverse proxy (Nginx/Railway...) thì đặt 1 để rate-limit lấy đúng IP khách. Để trống nếu chạy trực tiếp.
TRUST_PROXY=

# ---------------------------------------------------------------------
# 2. CƠ SỞ DỮ LIỆU (MySQL 8+)                                   [BẮT BUỘC]
# ---------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_DIALECT=mysql
DB_USERNAME=
DB_PASSWORD=
# Schema chuẩn v2 (xem DB_ThietKe_Moi.md). Dựng bằng: npm run db:reset
DB_DATABASE_NAME=webhealthcare_v2

# --- Chỉ dùng cho các script quản trị DB (npm run db:*), server KHÔNG đọc ---
# Tên DB v2 mà `db:create / db:migrate / db:seed / db:reset` thao tác (mặc định webhealthcare_v2)
V2_DB_NAME=webhealthcare_v2
# DB cũ (chỉ ĐỌC) làm nguồn cho `npm run db:import-v1`
V1_DB_NAME=webhealthcare

# ---------------------------------------------------------------------
# 3. XÁC THỰC (JWT + cookie)                                    [BẮT BUỘC]
# ---------------------------------------------------------------------
# Hai secret phải KHÁC nhau và dài >= 32 ký tự (bắt buộc ở production).
# Sinh bằng:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
# Access token ngắn hạn (mặc định 15m). Refresh token lưu trong DB, xoay vòng mỗi lần dùng (mặc định 7d).
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Thời hạn cookie, tính bằng mili-giây (86400000 = 1 ngày, 604800000 = 7 ngày)
COOKIE_EXPIRES_IN=86400000
COOKIE_REFRESH_EXPIRES_IN=604800000
# lax (mặc định) | none | strict. Frontend và backend khác "site" (vd. Vercel + Railway) => none
# (khi đó cần HTTPS; cookie tự bật `secure` ở production).
COOKIE_SAMESITE=lax

# ---------------------------------------------------------------------
# 4. ĐẶT LỊCH & LỊCH LÀM VIỆC
# ---------------------------------------------------------------------
# Số phút giữ chỗ chờ bệnh nhân bấm link xác nhận email, quá hạn thì tự nhả khung giờ (mặc định 15)
BOOKING_HOLD_MINUTES=15
# Sức chứa mặc định mỗi khung giờ khi bác sĩ tạo lịch (số nguyên >= 1; mặc định 10)
MAX_NUMBER_SCHEDULE=10

# ---------------------------------------------------------------------
# 5. EMAIL (Gmail SMTP: xác nhận đặt lịch, gửi đơn thuốc, biên lai)
# ---------------------------------------------------------------------
# Tài khoản Gmail + "Mật khẩu ứng dụng" (App Password, cần bật xác minh 2 bước). Không dùng mật khẩu đăng nhập thường.
EMAIL_APP=
EMAIL_APP_PASSWORD=

# ---------------------------------------------------------------------
# 6. THANH TOÁN
# ---------------------------------------------------------------------
# --- PayOS (https://my.payos.vn → Kênh thanh toán) ---
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# --- Casso (đối soát chuyển khoản) ---
# Khoá xác thực webhook: Casso gửi kèm header `secure-token-header`, phải khớp giá trị này
CASSO_WEBHOOK_KEY=
# API key để lấy danh sách giao dịch (/api/check-paid). Trước đây hard-code trong mã nguồn (đã bỏ) -> phải khai báo ở đây
CASSO_API_KEY=

# ---------------------------------------------------------------------
# 7. THÔNG BÁO ĐẨY (Firebase Cloud Messaging) – tuỳ chọn
#    Thiếu 3 biến này => push chạy chế độ giả lập (chỉ ghi log), hệ thống vẫn hoạt động.
# ---------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Dán nguyên private_key trong file service-account JSON, đặt trong dấu nháy kép, xuống dòng viết là \n
# Ví dụ: FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=

# ---------------------------------------------------------------------
# 8. REDIS (cache + hàng đợi gửi email) – tuỳ chọn
#    Không có Redis: cache chạy bằng bộ nhớ, email gửi trực tiếp (không retry).
# ---------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379
# Hàng đợi BullMQ đọc host/port riêng (khớp với REDIS_URL nếu dùng Redis từ xa)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ---------------------------------------------------------------------
# 9. AI SERVICE (Python/FastAPI, thư mục ai-service) – tuỳ chọn
#    Không cấu hình => hàng đợi vẫn chạy, ETA dùng trung bình lịch sử của bác sĩ; gợi ý chuyên khoa báo "chưa bật".
# ---------------------------------------------------------------------
# Địa chỉ AI Service (chạy: cd ai-service && python -m ai_service serve). Ví dụ: http://127.0.0.1:8001
AI_SERVICE_URL=
# Khớp với AI_SERVICE_TOKEN bên ai-service (để trống nếu AI Service không đặt token)
AI_SERVICE_TOKEN=
# Thời gian chờ tối đa mỗi lần gọi AI (ms). Quá hạn => dùng dự phòng
AI_TIMEOUT_MS=1500
# Ngắt mạch: sau N lần lỗi hạ tầng liên tiếp thì ngừng gọi AI trong khoảng nghỉ (ms) rồi thử lại
AI_CIRCUIT_FAILS=3
AI_CIRCUIT_COOLDOWN_MS=30000

# ---------------------------------------------------------------------
# 9b. CHATBOT TƯ VẤN (service Flask trong thư mục chatbot) – tuỳ chọn
# ---------------------------------------------------------------------
# Địa chỉ gốc của chatbot, dùng để sinh lời khuyên AI cho khảo sát sức khoẻ (gọi /generate_stream_question).
# Thiếu => dùng nội dung dự phòng. Ví dụ: http://localhost:5002
API_CHATBOT_URL=
# Webhook làm mới dữ liệu chatbot sau khi nội dung thay đổi (mặc định http://localhost:5002/api/webhook/sync_data)
CHATBOT_SYNC_URL=

# ---------------------------------------------------------------------
# 10. CHỈ DÙNG CHO KIỂM THỬ (không cần đặt trong .env thường)
# ---------------------------------------------------------------------
# npm run smoke:e2e  ->  BASE=http://localhost:6969 (địa chỉ server đang chạy)
# RUN_DB_TESTS=1 npm test  ->  bật các test tích hợp cần MySQL thật
