{
  "name": "nodejs",
  "version": "1.0.0",
  "description": "backend nodejs DucIT",
  "main": "server.js",
  "dependencies": {
    "@payos/node": "^2.0.5",
    "axios": "^1.11.0",
    "bcryptjs": "^3.0.2",
    "body-parser": "^2.2.0",
    "bullmq": "^5.78.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.1",
    "firebase-admin": "^13.10.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "mysql2": "^3.14.5",
    "node-fetch": "^2.7.0",
    "node-html-to-image": "^5.0.0",
    "nodemailer": "7.0.6",
    "pdfkit": "^0.17.2",
    "puppeteer": "^19.11.1",
    "redis": "^6.0.0",
    "sequelize": "^6.37.7",
    "slugify": "^1.6.6",
    "socket.io": "^4.8.1",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.3",
    "@babel/core": "^7.28.4",
    "@babel/node": "^7.28.0",
    "@babel/preset-env": "^7.28.3",
    "nodemon": "^3.1.10",
    "sequelize-cli": "^6.6.3",
    "supertest": "^7.3.2"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "dev": "nodemon --exec babel-node src/server.js",
    "build-src": "babel src -d build --copy-files",
    "build": "npm run build-src",
    "start": "node build/server.js",
    "db:create": "node scripts/db-v2-create.js",
    "db:migrate": "node scripts/db-v2-run.js migrate",
    "db:migrate:undo": "node scripts/db-v2-run.js undo",
    "db:seed": "node scripts/db-v2-run.js seed",
    "db:import-v1": "node scripts/migrate-v1-to-v2.js",
    "db:reset": "node scripts/db-v2-create.js --recreate && node scripts/db-v2-run.js migrate && node scripts/db-v2-run.js seed && node scripts/migrate-v1-to-v2.js",
    "db:check-models": "node scripts/check-models.js",
    "smoke:e2e": "node scripts/e2e-smoke.js",
    "smoke:doctor": "babel-node scripts/smoke-doctor.js",
    "smoke:content": "babel-node scripts/smoke-content.js",
    "smoke:misc": "babel-node scripts/smoke-misc.js"
  },
  "keywords": [
    "fullstack",
    "DucIT"
  ],
  "author": "TranXuanDucIT",
  "license": "ISC",
  "engines": {
    "node": "22.x"
  }
}
